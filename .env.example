# OpenRouter (required)
OPENROUTER_API_KEY=

# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Model configuration (optional — public model identifiers, not secrets)
DEFAULT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Per-role overrides, all optional — leave unset to fall back to DEFAULT_MODEL
# MODEL_JON_SNOW=
# MODEL_TYRION_LANNISTER=
# MODEL_DAENERYS_TARGARYEN=
# MODEL_GREY_WORM=
# MODEL_BARAK=
# MODEL_ELON=
# MODEL_SHAMGAR=

# Site gate token (optional, but recommended once traffic is public) — must
# match the SITE_GATE_TOKEN constant in public/app.js exactly, or every
# gated call fails with 401. Not a real secret (it's shipped in a public,
# unauthenticated static file either way) — see siteGate.ts for what it
# actually protects against. Leave unset to disable this layer entirely
# (fails open, never blocks real traffic on its own).
# SITE_GATE_TOKEN=
