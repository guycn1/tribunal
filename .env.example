# Copy this file to .env and fill in your real key.
# Get a key at https://openrouter.ai after creating an account and adding credit.
OPENROUTER_API_KEY=your_key_here

# Optional: override the port the server runs on.
PORT=3000

# Model configuration — PHASE A default: every agent role uses this one model.
DEFAULT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# PHASE B: uncomment and set these to give each role its own model instead
# of the shared default. All three judge models below are NVIDIA-served,
# by design: on Aug 14, 2026, two DIFFERENT Google-served free models
# (gemma-4-31b-it and gemma-4-26b-a4b-it, on two separate days) each hit
# a real 429 on OpenRouter's shared Google AI Studio pool, while every
# NVIDIA-served free model tried across the same session -- four of them,
# multiple calls each -- succeeded every time. That's not proof NVIDIA
# will always hold up, but it's the only provider with a real track
# record here, so the judges deliberately avoid Google entirely.
# MODEL_ADVOCATE_FOR_1=
# MODEL_ADVOCATE_FOR_2=
# MODEL_ADVOCATE_AGAINST_1=
# MODEL_ADVOCATE_AGAINST_2=
# MODEL_JUDGE_1=nvidia/nemotron-3-super-120b-a12b:free
# MODEL_JUDGE_2=nvidia/nemotron-3.5-lightning:free
# MODEL_JUDGE_3=nvidia/nemotron-nano-9b-v2:free
