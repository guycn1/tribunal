# OpenRouter (required)
OPENROUTER_API_KEY=

# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Model configuration (optional — public model identifiers, not secrets)
DEFAULT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Per-role overrides, all optional — leave unset to fall back to DEFAULT_MODEL
